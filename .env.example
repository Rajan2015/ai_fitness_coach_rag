# Twilio WhatsApp Sandbox credentials — never commit real values
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# Public base URL for the webhook (e.g. ngrok https URL), used for Twilio signature validation
PUBLIC_BASE_URL=

# Qdrant — local Docker (default) or Qdrant Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

LOG_LEVEL=INFO

# Twilio WhatsApp Sandbox credentials — never commit real values
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true

# Public base URL for the webhook (e.g. ngrok https URL), used for Twilio signature validation
PUBLIC_BASE_URL=

# Qdrant — local Docker (default) or Qdrant Cloud
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Postgres (Neon) — shared by the FastAPI backend and the Next.js dashboard
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Redis — used for dashboard OTP login codes
REDIS_URL=redis://localhost:6379/0

# Web dashboard's origin, allowed to call the OTP endpoints (CORS)
DASHBOARD_WEB_ORIGIN=http://localhost:3000

LOG_LEVEL=INFO
